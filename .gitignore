# secrets — 절대 커밋 금지
.env
.env.local
*.pem
*.key

# 토큰/캐시 (자격증명 파생물)
.cache/
.toss_token.json

# python
.venv/
venv/
__pycache__/
*.pyc
# .python-version 은 재현성 설정이므로 커밋한다 (gitignore 하지 않음)

# qlib 데이터/산출물
data/
mlruns/
*.bin
# Phase 4 시그널(생성물, 매 실행 재생성)
signals/
# 리밸런싱 주문로그(dry-run·실발주 산출물)
execution_logs/

# 문서 — 기본은 제외하고 카테고리별로 명시적으로 연다(화이트리스트).
# 블랙리스트로 하면 새 폴더가 기본 추적이라, 계좌정보가 든 문서를 무심코 넣으면
# 그대로 커밋된다. 실제로 그 사고를 한 번 겪었다(d3bd183).
docs/*
!docs/project/
!docs/research/

# 아래 셋은 화이트리스트에 없어 이미 제외되지만, **의도를 남기려고** 명시한다.
# findings/ = 계좌 고유 실측값(식별자·잔액·보유). 절대 추적 금지.
# tooling/  = 이 저장소 주제 밖(에이전트 도구 조사). 로컬 유지.
# plans/    = 작업계획서. 작업 하나가 끝나면 버릴 발판이라 추적하지 않는다.
#             ⚠️ 지우기 전에 durable 잔여(미조치 근거·다음 단계 관찰 목록)를
#             docs/project/로 옮길 것 — 추적 밖이라 git 이력에도 없다.
docs/findings/
docs/tooling/
docs/plans/

# 에이전트 지침(로컬 전용)
CLAUDE.md

# OS/IDE
.DS_Store
.vscode/
